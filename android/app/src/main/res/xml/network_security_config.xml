<?xml version="1.0" encoding="utf-8"?>
<!--
    All Fermata providers are HTTPS-only, so cleartext (http://) traffic is
    blocked everywhere except the loopback interface. just_audio runs a local
    HTTP proxy on 127.0.0.1 to implement request headers (e.g. OAuth
    "Authorization" on stream URLs), LockCachingAudioSource and
    StreamAudioSource; ExoPlayer must be allowed to talk to it in cleartext.
    See the just_audio README, "Platform specific configuration > Android".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
